# General Monorepo Settings
NODE_ENV=development
PORT=3000
API_PORT=8000

# Next.js Frontend
NEXT_PUBLIC_APP_NAME=LegalDesk AI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# FastAPI Backend Configuration
APP_NAME="LegalDesk AI API"
APP_ENV=development
DEBUG=true
SECRET_KEY=legaldesk_super_secret_enterprise_key_change_in_production_32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_USER=legaldesk
POSTGRES_PASSWORD=legaldesk_secure_pass
POSTGRES_DB=legaldesk_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://legaldesk:legaldesk_secure_pass@localhost:5432/legaldesk_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery Broker & Result Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
